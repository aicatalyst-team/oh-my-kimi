FROM registry.access.redhat.com/ubi9/nodejs-22

WORKDIR /opt/app-root/src

# Install system dependencies needed by OMK
USER 0
RUN dnf install -y git && dnf clean all

# Copy package files for dependency installation (layer caching)
# Use --chown to ensure the files and dirs are owned by the app user
COPY --chown=1001:0 package.json package-lock.json ./
COPY --chown=1001:0 packages/tui/package.json packages/tui/
COPY --chown=1001:0 packages/ai/package.json packages/ai/
COPY --chown=1001:0 packages/agent/package.json packages/agent/
COPY --chown=1001:0 packages/coding-agent/package.json packages/coding-agent/
COPY --chown=1001:0 packages/adaptorch-wpl/package.json packages/adaptorch-wpl/

USER 1001

# Install dependencies
RUN npm install --ignore-scripts 2>&1 || \
    (echo "Retrying with --legacy-peer-deps..." && npm install --ignore-scripts --legacy-peer-deps)

# Copy source code
COPY --chown=1001:0 . .

# Build the monorepo in order
RUN cd packages/tui && npx tsc -p tsconfig.build.json 2>&1 || npx tsc -p tsconfig.json 2>&1 || true
RUN cd packages/ai && npm run build 2>&1 || (npx tsc -p tsconfig.build.json 2>&1 || npx tsc -p tsconfig.json 2>&1 || true)
RUN cd packages/agent && npx tsc -p tsconfig.build.json 2>&1 || npx tsc -p tsconfig.json 2>&1 || true
RUN cd packages/coding-agent && npm run build 2>&1 || (npx tsc -p tsconfig.build.json 2>&1 || npx tsc -p tsconfig.json 2>&1 || true)

# OpenShift compatibility
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root

EXPOSE 8080

USER 1001

ENV PORT=8080
ENV NODE_ENV=production
ENV NO_COLOR=1

CMD ["node", "server.js"]
